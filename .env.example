API_HOST=127.0.0.1
API_PORT=8000
WEB_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3002,http://localhost:3002
LOG_LEVEL=INFO
MAX_REQUEST_BODY_BYTES=78643200
ENABLE_HSTS=false
ENABLE_CONTENT_SECURITY_POLICY=false
LOCAL_INGEST_ALLOWED_ROOTS=C:\Nirmiq-researchOS\data\raw,C:\Nirmiq-researchOS\data\raw\uploads
SECURITY_ALLOW_ARBITRARY_LOCAL_PATHS=false
# DIAGRAM_PATH=C:\Nirmiq-researchOS\data\processed\diagrams
OLLAMA_BASE_URL=http://127.0.0.1:11434
NIRMIQ_RUNTIME_PROFILE=auto
EMBED_MODEL=nomic-embed-text
RERANKER_MODEL=bge-reranker-base
GENERATOR_MODEL_DEFAULT=phi3:mini
GENERATOR_MODEL_CODE=deepseek-coder:6.7b
OLLAMA_TIMEOUT_SECONDS=120.0
GENERATOR_TEMPERATURE_GROUNDED=0.15
GENERATOR_TEMPERATURE_LONG_CONTEXT=0.85
RETRIEVAL_K_BM25=20
RETRIEVAL_K_VECTOR=20
RETRIEVAL_K_FUSED=24
RETRIEVAL_K_RERANK=8
RETRIEVAL_RRF_K=60
RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=2
RETRIEVAL_MIN_GROUNDING_SCORE=0.15
MEMORY_SNAPSHOT_INTERVAL_MESSAGES=6
MEMORY_SNAPSHOT_WINDOW_MESSAGES=12

# Advanced runtime overrides. Leave commented to use NIRMIQ_RUNTIME_PROFILE defaults.
