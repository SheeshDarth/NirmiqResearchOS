# NIRMIQ ResearchOS local backend runtime profile
# Copy the values you need into your shell environment before starting FastAPI.

# Local/offline model provider
OLLAMA_BASE_URL=http://127.0.0.1:11434
USE_OLLAMA_GENERATION=true
USE_OLLAMA_EMBEDDINGS=true
USE_OLLAMA_RERANKER=false

# RTX 4050-friendly defaults
LOW_MEMORY_MODE=true
OLLAMA_KEEP_ALIVE=45s
OLLAMA_NUM_CTX=3072
OLLAMA_NUM_PREDICT=768
OLLAMA_EMBED_BATCH_SIZE=8

# Leave unset for Ollama auto-placement. Set only if memory is unstable.
# OLLAMA_NUM_GPU=20
# OLLAMA_NUM_THREAD=6

# Model choices
GENERATOR_MODEL_DEFAULT=phi3:mini
GENERATOR_MODEL_CODE=deepseek-coder:6.7b
EMBED_MODEL=nomic-embed-text
RERANKER_MODEL=bge-reranker-base

# Grounded generation stays conservative; long-context drafting can be livelier.
GENERATOR_TEMPERATURE_GROUNDED=0.15
GENERATOR_TEMPERATURE_LONG_CONTEXT=0.85

# Retrieval budgets
RETRIEVAL_ENABLE_VECTOR=true
RETRIEVAL_K_BM25=20
RETRIEVAL_K_VECTOR=20
RETRIEVAL_K_FUSED=24
RETRIEVAL_K_RERANK=8
RETRIEVAL_MAX_CONTEXT_TOKENS=2400
RETRIEVAL_MIN_GROUNDING_SCORE=0.15

# Privacy guardrails
SECURITY_ALLOW_ARBITRARY_LOCAL_PATHS=false
