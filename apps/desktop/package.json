{
  "name": "nirmiq-academic-intelligence-desktop",
  "version": "0.5.0",
  "private": true,
  "author": "Siddharth P",
  "description": "Windows desktop shell for the local-first NIRMIQ Academic Intelligence runtime.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron --in-process-gpu --disable-gpu-sandbox --disable-gpu-compositing --disable-gpu-rasterization --disable-accelerated-2d-canvas --disable-features=UseSkiaRenderer,Vulkan,CanvasOopRasterization .",
    "dev": "electron --in-process-gpu --disable-gpu-sandbox --disable-gpu-compositing --disable-gpu-rasterization --disable-accelerated-2d-canvas --disable-features=UseSkiaRenderer,Vulkan,CanvasOopRasterization . --dev",
    "test": "node --test src/*.test.js",
    "pack": "electron-builder --dir",
    "package": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.nirmiq.academicintelligence",
    "productName": "NIRMIQ Academic Intelligence",
    "directories": {
      "output": "../../dist/desktop",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/nirmiq.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/nirmiq.ico",
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "artifactName": "${productName} ${version}.${ext}"
  }
}
